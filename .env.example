# Variables del ERP Mentes Brillantes. Copia este archivo a .env.local para
# trabajar en tu equipo; en produccion viven en Vercel (Settings -> Environment
# Variables). Nunca subas valores reales al repositorio.

# Supabase Configuration
# Obtén estos valores desde tu panel de Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-publica"

# Clave service-role de Supabase (SOLO servidor, NUNCA NEXT_PUBLIC). La usa el
# bot de Telegram (cliente admin) para leer el ERP saltando RLS de forma segura.
# Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# Login Google del MCP. Seguro por defecto: el botón y la ruta permanecen
# deshabilitados salvo que el proveedor Google ya esté activo en Supabase y
# esta variable server-side sea exactamente "true".
MCP_GOOGLE_AUTH_ENABLED="false"

# Firma de los tokens del conector MCP (OAuth). Debe ser un secreto propio y
# largo (p. ej. `openssl rand -base64 48`). Si falta, se deriva de la clave
# service-role: funciona, pero cambiar esa clave cerraria todas las sesiones MCP.
MCP_OAUTH_SIGNING_SECRET="un-secreto-largo-y-aleatorio"

# Origen publico del MCP (sin barra final). Sin ella se usa el dominio de Vercel.
MCP_PUBLIC_ORIGIN="https://mentes-brillantes-erp.vercel.app"
# Opcionales: redirecciones OAuth extra permitidas (CSV, solo https o localhost)
# y origenes extra que pueden llamar al MCP desde el navegador (CSV).
# MCP_ALLOWED_REDIRECT_URIS=""
# MCP_ALLOWED_ORIGINS=""

# ----------------------------------------------------------------------------
# Integracion con la Agenda Mentes Brillantes y tareas programadas
# ----------------------------------------------------------------------------
# Secreto compartido con el servidor de la agenda (cabecera x-agenda-secret).
# Debe ser EL MISMO valor en los dos proyectos.
AGENDA_SHARED_SECRET="otro-secreto-largo"
# Lo pone Vercel solo para sus crons (/api/cron/*). Se exige como
# "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET="secreto-de-los-crons"

# Sentry: solo para subir los mapas de codigo al compilar (opcional).
# SENTRY_AUTH_TOKEN=""

# ----------------------------------------------------------------------------
# Bots de IA (DeepSeek, vía endpoint compatible con OpenAI: /chat/completions).
# IMPORTANTE: el bot WEB (Asistente IA) y el bot de TELEGRAM usan variables
# DISTINTAS (no se comparten). Si faltan, el bot respectivo deja de responder.
# Estas variables viven SOLO en el entorno de despliegue (p. ej. Vercel).
# ----------------------------------------------------------------------------

# Bot interno web (/asistente-ia). Sin la clave y la URL base, el endpoint
# responde "DeepSeek no está configurado en el servidor" (el modelo ya tiene
# valor por defecto en el código).
DEEPSEEK_API_KEY="sk-..."
# DEEPSEEK_MODEL es OPCIONAL: si no se define, el codigo usa "deepseek-v4-flash".
# Modelos validos hoy: deepseek-v4-flash y deepseek-v4-pro. Definela solo para
# forzar otro modelo (p. ej. volver a Pro) sin tocar codigo.
DEEPSEEK_MODEL="deepseek-v4-flash"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Bot de Telegram (cajero). Mensajería:
TELEGRAM_BOT_TOKEN="123456:ABC..."           # token del bot (@BotFather)
TELEGRAM_WEBHOOK_SECRET="un-secreto-largo"    # secret_token del webhook
# Chat/grupo permitido (OBLIGATORIO). El bot solo opera en este chat; al ser un
# grupo privado, controlas el acceso administrando quien esta en el grupo.
# Envia /id al bot para obtener el chat_id (en grupos es negativo):
TELEGRAM_ALLOWED_CHAT_ID="-1001234567890"
# Lista de usuarios permitidos (OPCIONAL, CSV). Si se deja VACIA, cualquier
# miembro del chat permitido puede usar el bot (sin registrarse uno por uno).
# Si se especifica, restringe a esos user ids:
TELEGRAM_ALLOWED_USER_IDS=""
# IA del bot de Telegram (separadas de las del bot web):
DEEPSEEK_TELEGRAM_API_KEY="sk-..."
DEEPSEEK_TELEGRAM_BASE_URL="https://api.deepseek.com"
# Tambien OPCIONAL: sin ella se hereda DEEPSEEK_MODEL y, si tampoco esta, se usa
# "deepseek-v4-flash".
DEEPSEEK_TELEGRAM_MODEL="deepseek-v4-flash"
# Mantener SIN definir (o != true) para conservar el bot en SOLO LECTURA:
# TELEGRAM_CAJERO_ENABLE_WRITE_ACTIONS="false"
